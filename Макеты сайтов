import speech_recognition as sr
import pyttsx3
import webbrowser
import subprocess
import datetime
import os


# =========================
# НАСТРОЙКА ГОЛОСА
# =========================

engine = pyttsx3.init()

engine.setProperty("rate", 175)
engine.setProperty("volume", 1.0)


def speak(text):
    print("Ассистент:", text)
    engine.say(text)
    engine.runAndWait()


# =========================
# РАСПОЗНАВАНИЕ РЕЧИ
# =========================

recognizer = sr.Recognizer()


def listen():
    with sr.Microphone() as source:

        print("\n🎤 Слушаю...")

        recognizer.adjust_for_ambient_noise(source, duration=0.5)

        try:
            audio = recognizer.listen(
                source,
                timeout=5,
                phrase_time_limit=8
            )

            print("🔄 Распознаю...")

            text = recognizer.recognize_google(
                audio,
                language="ru-RU"
            )

            print("Ты:", text)

            return text.lower()

        except sr.WaitTimeoutError:
            return ""

        except sr.UnknownValueError:
            speak("Я не расслышал.")
            return ""

        except sr.RequestError:
            speak("Не удалось подключиться к сервису распознавания.")
            return ""


# =========================
# КОМАНДЫ
# =========================

def process_command(command):

    # Выход
    if "выключись" in command or "заверши работу" in command:
        speak("Хорошо. До встречи.")
        return False


    # Время
    elif "который час" in command or "время" in command:

        now = datetime.datetime.now()

        speak(
            f"Сейчас {now.hour} часов {now.minute} минут."
        )


    # Дата
    elif "какое сегодня число" in command or "дата" in command:

        today = datetime.datetime.now()

        speak(
            f"Сегодня {today.day} "
            f"{today.month} месяц "
            f"{today.year} года."
        )


    # YouTube
    elif "открой ютуб" in command or "открой youtube" in command:

        speak("Открываю YouTube.")

        webbrowser.open(
            "https://www.youtube.com"
        )


    # Google
    elif "открой гугл" in command or "открой google" in command:

        speak("Открываю Google.")

        webbrowser.open(
            "https://www.google.com"
        )


    # ChatGPT
    elif "открой чат" in command or "открой chatgpt" in command:

        speak("Открываю ChatGPT.")

        webbrowser.open(
            "https://chatgpt.com"
        )


    # Калькулятор Windows
    elif "открой калькулятор" in command:

        speak("Запускаю калькулятор.")

        subprocess.Popen(
            "calc.exe"
        )


    # Блокнот
    elif "открой блокнот" in command:

        speak("Запускаю блокнот.")

        subprocess.Popen(
            "notepad.exe"
        )


    # Проводник
    elif "открой проводник" in command:

        speak("Открываю проводник.")

        subprocess.Popen(
            "explorer.exe"
        )


    # Поиск Google
    elif command.startswith("найди"):

        query = command.replace(
            "найди", "", 1
        ).strip()

        if query:

            speak(
                f"Ищу {query}."
            )

            url = (
                "https://www.google.com/search?q="
                + query.replace(" ", "+")
            )

            webbrowser.open(url)

        else:

            speak("Что мне найти?")


    # Приветствие
    elif "привет" in command:

        speak("Привет! Чем могу помочь?")


    # Неизвестная команда
    else:

        speak(
            "Я пока не умею выполнять эту команду."
        )

    return True


# =========================
# ЗАПУСК
# =========================

def main():

    speak(
        "Привет! Я готов к работе."
    )

    while True:

        command = listen()

        if command:

            running = process_command(
                command
            )

            if not running:
                break


if __name__ == "__main__":
    main()
