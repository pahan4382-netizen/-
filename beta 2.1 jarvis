def clean_answer(text):
    """Убирает разметку, которую нельзя читать вслух."""
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"[*_`#>|]", "", text)
    text = re.sub(r"https?://\S+", "", text)
    return re.sub(r"\s+", " ", text).strip()


def ai_ask(text, image=None):
    """Отправляет вопрос модели и возвращает текстовый ответ. image - PNG в байтах."""
    system = AI_SYSTEM.format(date=datetime.now().strftime("%d.%m.%Y"))
    b64 = base64.b64encode(image).decode() if image else None

    if AI_PROVIDER == "anthropic":
        content = text
        if b64:
            content = [
                {"type": "image", "source": {"type": "base64",
                                             "media_type": "image/png", "data": b64}},
                {"type": "text", "text": text},
            ]
        body = {"model": AI_MODEL, "max_tokens": 400, "system": system,
                "messages": HISTORY + [{"role": "user", "content": content}]}
        headers = {"x-api-key": AI_KEY, "anthropic-version": "2023-06-01",
                   "content-type": "application/json"}
    else:
        content = text
        if b64:
            content = [
                {"type": "text", "text": text},
                {"type": "image_url", "image_url": {"url": "data:image/png;base64," + b64}},
            ]
        body = {"model": AI_MODEL, "max_tokens": 400,
                "messages": [{"role": "system", "content": system}] + HISTORY
                            + [{"role": "user", "content": content}]}
        headers = {"Authorization": "Bearer " + AI_KEY, "Content-Type": "application/json"}

    req = urllib.request.Request(AI_URL, json.dumps(body).encode("utf-8"), headers)
    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.loads(resp.read().decode("utf-8"))

    if AI_PROVIDER == "anthropic":
        answer = "".join(b.get("text", "") for b in data["content"] if b.get("type") == "text")
    else:
        answer = data["choices"][0]["message"]["content"]
    answer = clean_answer(answer)

    # в память кладём только текст (скриншоты не храним)
    HISTORY.append({"role": "user", "content": text})
    HISTORY.append({"role": "assistant", "content": answer})
    del HISTORY[:-AI_MAX_HISTORY]
    return answer


def ai_answer(text, image=None):
    """Спрашивает ИИ и озвучивает ответ."""
    if not AI_ENABLED:
        speak("ИИ не настроен. Задайте ключ в переменной окружения, подробности в коде")
        return
    STATE["mode"] = "thinking"
    try:
        answer = ai_ask(text, image)
    except urllib.error.HTTPError as e:
        log("AI HTTP %s: %s" % (e.code, e.read().decode("utf-8", "ignore")))
        speak("Сервер ИИ вернул ошибку %s" % e.code)
        return
    except Exception:
        log()
        speak("Не получилось связаться с ИИ")
        return
    STATE["last_answer"] = answer
    speak(answer or "ИИ ничего не ответил")


