    (("громче", "прибавь звук"), lambda: press("volumeup", times=5)),
    (("тише", "убавь звук"), lambda: press("volumedown", times=5)),
    (("без звука", "выключи звук"), lambda: press("volumemute")),
]


def parse_search(text):
    """«найди в ютубе котики» -> (сайт, ссылка, запрос). Без сайта ищет в Google."""
    m = re.search(r"\b(?:найди|поищи|ищи|загугли)\s+(.*)", text)
    if not m:
        return None
    rest = m.group(1).strip()
    site, template = GOOGLE
    m2 = re.match(r"(?:мне\s+)?(?:в|на)\s+(\S+)\s*(.*)", rest)
    if m2:
        word = m2.group(1)
        if word.startswith(("интернет", "сети")):
            rest = m2.group(2)
        else:
            for key, (name, url) in SEARCH_SITES.items():
                if word.startswith(key):
                    site, template, rest = name, url, m2.group(2)
                    break
    rest = re.sub(r"^(?:видео|ролики|ролик|видос)\s+", "", rest.strip()).strip()
    rest = re.sub(r"^про\s+", "", rest)  # «видео про котов» -> «котов»
    if not rest:
        return None
    return site, template.format(q=urllib.parse.quote_plus(rest)), rest


def parse_play(text):
    """«включи видео про котов» или «включи на ютубе X» -> запрос для YouTube."""
    m = re.search(
        r"\b(?:включи|поставь|запусти)\s+(?:мне\s+)?"
        r"(?:(?:в|на)\s+ютуб\w*\s+|(?:видео|ролик|клип|песню|музыку|трек)\s+)(.+)",
        text,
    )
    return re.sub(r"^про\s+", "", m.group(1).strip()) if m else None


def first_youtube_video(query):
    """Находит первое видео по запросу. Если не вышло, возвращает None."""
    try:
        url = "https://www.youtube.com/results?search_query=" + urllib.parse.quote_plus(query)
        req = urllib.request.Request(url, headers={
            "User-Agent": "Mozilla/5.0",
            "Accept-Language": "ru-RU,ru;q=0.9",
        })
        html = urllib.request.urlopen(req, timeout=10).read().decode("utf-8", "ignore")
        m = (re.search(r'"videoRenderer":\{"videoId":"([\w-]{11})"', html)
             or re.search(r'"videoId":"([\w-]{11})"', html))
        return m.group(1) if m else None
    except Exception:
        return None


def browser_control(text):
    """Выполняет команду управления браузером. Возвращает True, если нашла."""
    for phrases, action in CONTROLS:
        if any(p in text for p in phrases):
            if pyautogui is None:
                speak("Для управления браузером установите pyautogui")
            else:
                action()
                speak("Готово")
            return True
    return False


# ---------------- Команды ----------------


def handle(text):
    """Выполняет команду. Возвращает False, если нужно выключиться."""
    global APP_INDEX

    play = parse_play(text)      # «включи видео ...»
    search = parse_search(text)  # «найди в ютубе ...»

    if len(text.split()) <= 4 and ("время" in text or "времени" in text
                                   or "который час" in text):
        speak("Сейчас " + datetime.now().strftime("%H:%M"))

    elif "обнови программы" in text:
        APP_INDEX = build_app_index()
        speak("Список программ обновлён")

    elif any(p in text for p in ("забудь разговор", "сбрось диалог", "новый диалог")):
        HISTORY.clear()
        speak("Диалог сброшен")

    elif any(p in text for p in ("на экране", "посмотри на экран", "что я вижу")):
        ask_about_screen(text)

    elif "буфер" in text:
        ask_about_clipboard(text)

    elif play:
        speak("Включаю " + play)
        video = first_youtube_video(play)
        if video:
            webbrowser.open("https://www.youtube.com/watch?v=" + video)
        else:  # не получилось найти ролик: открываем результаты поиска
            webbrowser.open(SEARCH_SITES["ютуб"][1].format(q=urllib.parse.quote_plus(play)))

    elif search:
        site, url, query = search
        speak("Ищу " + query)
        webbrowser.open(url)

    elif browser_control(text):
        pass  # команда выполнена внутри browser_control

    elif "открой файл" in text or "открой папку" in text:
        name = get_name(text, ("открой файл", "открой папку"))
        path = find_file(name)
        if path:
            speak("Открываю " + name)
            os.startfile(path)
        else:
            speak("Не нашёл " + name)

    # вопросы к ИИ проверяем раньше TRIGGERS: в «расскажи, как включить»
    # есть слово «включи», но открывать ничего не нужно
    elif text.startswith(AI_PREFIXES):
        ai_answer(text.replace("спроси", "", 1).strip() or text)

    elif any(word in text for word in TRIGGERS):
        name = get_name(text, TRIGGERS)
        if open_site(name) or launch_app(name):
            speak("Открываю " + name)
        else:
            speak("Не нашёл программу " + name)

    elif "выключись" in text or "выход" in text:
        speak("До связи, сэр")
        return False

    elif AI_ENABLED:
        ai_answer(text)  # непонятная фраза: пусть разбирается ИИ

    else:
        speak("Я не понял команду")

    return True


# ---------------- Работа помощника (в отдельном потоке) ----------------


def service_requests():
    """Обрабатывает просьбы из меню окна."""
    global APP_INDEX

    if STATE["reload"]:
        STATE["reload"] = False
        APP_INDEX = build_app_index()
        speak("Список программ обновлён")

    if STATE["reload_mic"]:
        STATE["reload_mic"] = False
        try:
            open_mic()
            speak("Микрофон переключён")
        except Exception:
            log()
            STATE["mode"] = "error"
            time.sleep(2)
            STATE["mode"] = "idle"

    if STATE["calibrate"]:
        STATE["calibrate"] = False
        STATE["mode"] = "listening"
        calibrate()
        speak("Микрофон настроен")

    if STATE["mic_test"]:
        STATE["mic_test"] = False
        speak("Скажите что-нибудь")
        STATE["mode"] = "listening"
        variants = listen(timeout=5, limit=6)
        if variants:
            speak("Я услышал: " + variants[0])
        else:
            speak("Ничего не услышал. Порог чувствительности %d" % recognizer.energy_threshold)


def assistant():
    global engine, APP_INDEX
    try:
        try:
            import pythoncom
            pythoncom.CoInitialize()  # нужно для голоса в отдельном потоке
        except ImportError:
            pass

        engine = pyttsx3.init()
        APP_INDEX = build_app_index()
        open_mic()   # открываем и калибруем до приветствия, пока вокруг тихо
        speak("Приветствую вас, сэр")
        last_net_warning = 0

        while not STATE["quit"]:
            service_requests()

            variants = listen(timeout=2, limit=10)

            if STATE["net_error"] and time.time() - last_net_warning > 60:
                last_net_warning = time.time()
                speak("Нет связи с сервисом распознавания речи. Проверьте интернет")

            manual = STATE["manual"]  # нажали на микрофон
            STATE["manual"] = False
            found = find_wake(variants)
            if not found and not manual:
                if STATE["mode"] == "listening":
                    STATE["mode"] = "idle"
                continue

            # Команда может прозвучать сразу: «эй джарвис, открой ютуб»
            command = found[0] if found else ""
            if not command:
                speak("Слушаю, сэр")
                STATE["mode"] = "listening"
                for attempt in range(2):   # даём вторую попытку
                    variants = listen(timeout=6, limit=12)
                    if variants:
                        command = variants[0]
                        break
                    if attempt == 0:
                        speak("Повторите, пожалуйста")
                        STATE["mode"] = "listening"
                if not command:
                    STATE["mode"] = "idle"
                    speak("Не расслышал")
                    continue

            STATE["mode"] = "listening"
            try:
                if not handle(command):
                    break
            except Exception:
                log()
                STATE["mode"] = "error"
                time.sleep(2)
                STATE["mode"] = "idle"
    except Exception:
        log()
        STATE["mode"] = "error"  # красный микрофон: смотрите jarvis_error.log
        return
    finally:
        close_mic()

    STATE["quit"] = True


