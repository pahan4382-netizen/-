#  2. пока помощник говорил, голос из колонок копился в буфере и мешал;
#  3. слово «Джарвис» искалось только по точному совпадению.
# Теперь микрофон открыт постоянно, калибруется один раз, буфер очищается,
# а имя ищется «нечётко».

recognizer.dynamic_energy_threshold = True          # порог сам подстраивается
recognizer.dynamic_energy_adjustment_damping = 0.10
recognizer.dynamic_energy_ratio = 1.4
recognizer.pause_threshold = 0.8                    # пауза, после которой фраза считается законченной
recognizer.non_speaking_duration = 0.5              # тишина по краям записи
recognizer.phrase_threshold = 0.25                  # минимальная длина речи

MAX_ENERGY = 1000000000000000000000000000     # потолок порога: выше микрофон становится «глухим»
MIN_ENERGY = 1

MIC = {"obj": None, "source": None}


def close_mic():
    if MIC["obj"] is not None:
        try:
            MIC["obj"].__exit__(None, None, None)
        except Exception:
            pass
    MIC["obj"] = MIC["source"] = None


def calibrate():
    """Замеряет шум в комнате (нужна тишина около секунды)."""
    recognizer.adjust_for_ambient_noise(MIC["source"], duration=1.0)
    recognizer.energy_threshold = min(max(recognizer.energy_threshold, MIN_ENERGY), MAX_ENERGY)
    print("Порог чувствительности:", int(recognizer.energy_threshold))


def open_mic():
    close_mic()
    obj = sr.Microphone(device_index=SETTINGS.get("mic_index"))
    MIC["source"] = obj.__enter__()
    MIC["obj"] = obj
    calibrate()


def flush_mic():
    """Выбрасывает накопленный звук (например, голос самого помощника)."""
    try:
        stream = MIC["source"].stream.pyaudio_stream
        available = stream.get_read_available()
        if available:
            stream.read(available, exception_on_overflow=False)
    except Exception:
        pass


def recognize(audio):
    """Возвращает список вариантов распознавания (лучший первым)."""
    try:
        result = recognizer.recognize_google(audio, language="ru-RU", show_all=True)
    except sr.RequestError:
        STATE["net_error"] = True
        time.sleep(20)
        return []
    except sr.UnknownValueError:
        return []
    if not isinstance(result, dict):
        return []
    variants = [a["transcript"].lower() for a in result.get("alternative", [])
                if a.get("transcript")]
    if variants:
        STATE["net_error"] = False
        print("Вы:", variants[0])
    return variants


def listen(timeout=None, limit=8):
    """Слушает микрофон. Возвращает список вариантов текста (пустой, если тишина)."""
    flush_mic()
    try:
        audio = recognizer.listen(MIC["source"], timeout=timeout, phrase_time_limit=limit)
    except sr.WaitTimeoutError:
        return []
    return recognize(audio)


def find_wake(variants):
    """Ищет слово активации (с учётом неточного распознавания).
    Возвращает (команда после имени, текст) или None."""
    for text in variants:
        words = text.split()
        for i, raw in enumerate(words):
            w = raw.strip(",.!?-—")
            if len(w) < 4:
                continue
            if w in WAKE_WORDS or difflib.get_close_matches(w, WAKE_WORDS, n=1, cutoff=0.78):
                return " ".join(words[i + 1:]).strip(" ,.!"), text
    return None


